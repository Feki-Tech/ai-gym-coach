# Turn-taking timelines replayed by coach_voice.run_scenario with a fake clock (30 ms ticks).
# Events: mic_ready, mic_lost, speech_start, speech_end, blip, transcript{text|words}, typed{words}, barge_in, tts{on}, busy{on}.
# Expectations: final_state, states (exact transition list), effects (exact earcon list), turns (count), turn[{index,metric:[lo,hi]|value}], state_at[[t,state]], gate_at[[t,open]], label_at[[t,substring]], gate_always_open_after, gate_never_open.
{"id": "voice_question_gated", "about": "a spoken question on speakers: hear → captured tick → thinking → coach speaks (mic closed) → open tone → listening", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 2.5, "ev": "speech_end"}, {"at": 3.0, "ev": "transcript", "text": "how deep should I squat"}, {"at": 3.05, "ev": "busy", "on": true}, {"at": 5.0, "ev": "tts", "on": true}, {"at": 6.0, "ev": "busy", "on": false}, {"at": 8.0, "ev": "tts", "on": false}], "until": 10, "expect": {"final_state": "listening", "states": ["listening", "hearing", "thinking", "speaking", "listening"], "effects": ["open", "captured", "open"], "turns": 1, "turn": [{"source": "voice", "words": 5, "stt_ms": [400, 560], "ttfa_ms": [2400, 2600], "speak_ms": [3400, 3600], "interrupted": false}], "state_at": [[1.5, "hearing"], [4.0, "thinking"], [5.5, "speaking"], [8.3, "speaking"], [8.6, "listening"]], "gate_at": [[0.5, true], [1.5, true], [3.5, false], [5.5, false], [8.3, false], [8.6, true]], "label_at": [[4.5, "thinking"], [5.5, "coach speaking"]]}}
{"id": "slow_llm_pulses", "about": "a 12 s answer on a slow CPU: soft 'thinking' pulses every 5 s and a counting label", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 2.5, "ev": "speech_end"}, {"at": 3.0, "ev": "transcript", "words": 5}, {"at": 3.05, "ev": "busy", "on": true}, {"at": 15.0, "ev": "tts", "on": true}, {"at": 16.0, "ev": "busy", "on": false}, {"at": 18.0, "ev": "tts", "on": false}], "until": 20, "expect": {"final_state": "listening", "effects": ["open", "captured", "thinking", "thinking", "open"], "turns": 1, "turn": [{"ttfa_ms": [12400, 12600]}], "label_at": [[10.02, "thinking… 7 s"]]}}
{"id": "clank_blip_ignored", "about": "a dropped plate: too short to be speech, nothing happens", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 1.2, "ev": "blip"}], "until": 3, "expect": {"final_state": "listening", "states": ["listening", "hearing", "listening"], "effects": ["open"], "turns": 0}}
{"id": "junk_transcript_rejected", "about": "long enough for Whisper but no words came out: falling tone, mic back", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 2.0, "ev": "speech_end"}, {"at": 2.6, "ev": "transcript", "text": ""}], "until": 4, "expect": {"final_state": "listening", "states": ["listening", "hearing", "thinking", "listening"], "effects": ["open", "captured", "reject"], "turns": 0, "gate_at": [[2.3, false], [2.7, true]]}}
{"id": "barge_in_key", "about": "the c key mid-answer: open tone at once, mic open 0.3 s later, turn logged as interrupted", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 4}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 3.0, "ev": "tts", "on": true}, {"at": 6.0, "ev": "barge_in"}, {"at": 6.05, "ev": "tts", "on": false}, {"at": 6.05, "ev": "busy", "on": false}], "until": 8, "expect": {"final_state": "listening", "states": ["listening", "thinking", "speaking", "listening"], "effects": ["open", "open"], "turns": 1, "turn": [{"source": "typed", "interrupted": true}], "state_at": [[6.2, "speaking"], [6.36, "listening"]], "gate_at": [[6.2, false], [6.36, true]]}}
{"id": "typed_while_speaking", "about": "a new question while the coach talks: old turn interrupted, the dying TTS does not flip the state back", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 3}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 3.0, "ev": "tts", "on": true}, {"at": 6.0, "ev": "typed", "words": 5}, {"at": 6.05, "ev": "tts", "on": false}, {"at": 6.05, "ev": "busy", "on": false}, {"at": 6.5, "ev": "busy", "on": true}, {"at": 8.0, "ev": "tts", "on": true}, {"at": 9.0, "ev": "busy", "on": false}, {"at": 11.0, "ev": "tts", "on": false}], "until": 13, "expect": {"final_state": "listening", "states": ["listening", "thinking", "speaking", "thinking", "speaking", "listening"], "effects": ["open", "open"], "turns": 2, "turn": [{"index": 0, "interrupted": true}, {"index": 1, "interrupted": false, "ttfa_ms": [1900, 2100]}], "state_at": [[6.2, "thinking"]], "gate_at": [[6.2, false]]}}
{"id": "form_cue_no_earcon", "about": "a short form cue closes the mic briefly; no tone, it would be noise", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 2.0, "ev": "tts", "on": true}, {"at": 2.8, "ev": "tts", "on": false}], "until": 5, "expect": {"final_state": "listening", "states": ["listening", "speaking", "listening"], "effects": ["open"], "turns": 0, "gate_at": [[2.5, false], [3.2, false], [3.4, true]]}}
{"id": "proactive_brief_long", "about": "the coach speaks up on its own for 3.5 s: an open tone tells you it is done", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "busy", "on": true}, {"at": 2.5, "ev": "tts", "on": true}, {"at": 3.0, "ev": "busy", "on": false}, {"at": 6.0, "ev": "tts", "on": false}], "until": 8, "expect": {"final_state": "listening", "states": ["listening", "thinking", "speaking", "listening"], "effects": ["open", "open"], "turns": 0}}
{"id": "headset_interrupt_by_voice", "full_duplex": true, "about": "--headset: the mic never closes; talking over the coach interrupts it; no open tones", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 2.0, "ev": "speech_end"}, {"at": 2.5, "ev": "transcript", "text": "how deep should I squat"}, {"at": 2.55, "ev": "busy", "on": true}, {"at": 4.0, "ev": "tts", "on": true}, {"at": 5.0, "ev": "busy", "on": false}, {"at": 6.0, "ev": "speech_start"}, {"at": 7.0, "ev": "speech_end"}, {"at": 7.4, "ev": "transcript", "text": "wait what about my knees"}, {"at": 7.45, "ev": "tts", "on": false}, {"at": 7.5, "ev": "busy", "on": true}, {"at": 9.0, "ev": "tts", "on": true}, {"at": 10.0, "ev": "busy", "on": false}, {"at": 11.0, "ev": "tts", "on": false}], "until": 12, "expect": {"final_state": "listening", "states": ["listening", "hearing", "thinking", "speaking", "hearing", "thinking", "speaking", "listening"], "effects": ["open", "captured", "captured"], "turns": 2, "turn": [{"index": 0, "interrupted": true}, {"index": 1, "interrupted": false, "full_duplex": true}], "gate_always_open_after": 0.0, "label_at": [[5.5, "coach speaking"]]}}
{"id": "headset_echo_is_a_blip", "full_duplex": true, "about": "--headset: the coach's own voice leaks in, is transcribed, matches what it just said → dropped, the answer goes on", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 3}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 2.0, "ev": "tts", "on": true}, {"at": 3.0, "ev": "busy", "on": false}, {"at": 3.5, "ev": "speech_start"}, {"at": 4.5, "ev": "speech_end"}, {"at": 4.9, "ev": "blip"}, {"at": 7.0, "ev": "tts", "on": false}], "until": 8, "expect": {"final_state": "listening", "states": ["listening", "thinking", "speaking", "hearing", "thinking", "speaking", "listening"], "effects": ["open", "captured"], "turns": 1, "turn": [{"interrupted": false}], "gate_always_open_after": 0.0}}
{"id": "answer_without_audio", "about": "voice muted or the LLM offline: the answer ends without a sound, the mic comes back with a tone", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 2}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 2.5, "ev": "busy", "on": false}], "until": 4, "expect": {"final_state": "listening", "states": ["listening", "thinking", "listening"], "effects": ["open", "open"], "turns": 1, "turn": [{"ttfa_ms": null, "interrupted": false}]}}
{"id": "no_answer_timeout", "about": "the question never reaches an answer: after 8 s the mic is given back", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 2}], "until": 10, "expect": {"final_state": "listening", "states": ["listening", "thinking", "listening"], "effects": ["open", "thinking", "open"], "turns": 1, "state_at": [[8.5, "thinking"], [9.2, "listening"]], "label_at": [[8.5, "thinking… 7 s"]]}}
{"id": "no_mic_typed_only", "about": "no voice extras: typed questions still show thinking / speaking, the mic never opens, no tones", "steps": [{"at": 1.0, "ev": "typed", "words": 3}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 2.0, "ev": "tts", "on": true}, {"at": 3.0, "ev": "busy", "on": false}, {"at": 4.0, "ev": "tts", "on": false}], "until": 6, "expect": {"final_state": "off", "states": ["thinking", "speaking", "off"], "effects": [], "turns": 1, "gate_never_open": true}}
{"id": "cue_cuts_capture", "about": "a form cue fires while you are mid-sentence on speakers: the capture is lost honestly (speaking), an open tone says 'go again', no phantom turn", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 1.5, "ev": "tts", "on": true}, {"at": 2.0, "ev": "tts", "on": false}], "until": 4, "expect": {"final_state": "listening", "states": ["listening", "hearing", "speaking", "listening"], "effects": ["open", "open"], "turns": 0}}
{"id": "cue_during_transcription", "about": "a form cue while your sentence is being transcribed: still 'thinking', the cue is not the answer, metrics stay clean", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "speech_start"}, {"at": 2.0, "ev": "speech_end"}, {"at": 2.2, "ev": "tts", "on": true}, {"at": 2.8, "ev": "tts", "on": false}, {"at": 3.0, "ev": "transcript", "words": 4}, {"at": 3.05, "ev": "busy", "on": true}, {"at": 4.0, "ev": "tts", "on": true}, {"at": 4.5, "ev": "busy", "on": false}, {"at": 6.0, "ev": "tts", "on": false}], "until": 8, "expect": {"final_state": "listening", "states": ["listening", "hearing", "thinking", "speaking", "listening"], "effects": ["open", "captured", "open"], "turns": 1, "turn": [{"ttfa_ms": [1900, 2100], "interrupted": false}], "state_at": [[2.5, "thinking"]]}}
{"id": "mic_lost_mid_answer", "about": "the microphone disappears while the coach answers: off, and the coach finishing is still shown", "steps": [{"at": 0, "ev": "mic_ready"}, {"at": 1.0, "ev": "typed", "words": 3}, {"at": 1.02, "ev": "busy", "on": true}, {"at": 2.0, "ev": "tts", "on": true}, {"at": 3.0, "ev": "mic_lost"}, {"at": 4.0, "ev": "tts", "on": false}, {"at": 4.0, "ev": "busy", "on": false}], "until": 6, "expect": {"final_state": "off", "states": ["listening", "thinking", "speaking", "off", "speaking", "off"], "effects": ["open"], "turns": 1, "turn": [{"interrupted": true}]}}
